RewriteEngine On

# Maneig d'errors (sense ErrorDocument per evitar rutes absolutes)
RewriteRule ^404$ app/vista/error/404.php [L]
RewriteRule ^401$ app/vista/error/401.php [L]

# Fallback 404 si no existeix fitxer o directori
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . app/vista/error/404.php [L]